# === Configurare aplicație ===
# Mediul: development sau production
FLASK_ENV=development

# Chei secrete (SCHIMBĂ-LE în producție!)
SECRET_KEY=schimba-aceasta-cheie-secreta-foarte-lunga
JWT_SECRET_KEY=schimba-aceasta-cheie-jwt-foarte-lunga
# Durata de valabilitate a token-ului de acces (ore)
JWT_EXPIRES_HOURS=12

# === Baza de date PostgreSQL ===
# Format: postgresql://utilizator:parola@host:port/nume_baza
DATABASE_URL=postgresql://iot_user:iot_parola@localhost:5432/iot_platforma

# === Broker MQTT (Mosquitto) ===
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Lasă gol dacă brokerul nu cere autentificare
MQTT_USERNAME=
MQTT_PASSWORD=

# Timpul (secunde) după care un dispozitiv fără semnal este marcat ca offline
DEVICE_OFFLINE_TIMEOUT=90

# Portul pe care rulează serverul backend
PORT=5000

# Originile permise pentru CORS (frontend). Separate prin virgulă.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
