# Configurare client Raspberry Pi 5

# Adresa brokerului MQTT (IP-ul calculatorului unde rulează platforma)
BROKER_MQTT=192.168.1.10
PORT_MQTT=1883

# Codul dispozitivului (trebuie să corespundă cu cel din platformă)
COD_DISPOZITIV=rpi5-roby

# Interval între măsurători (secunde)
INTERVAL=10

# Utilizator și parolă MQTT (lasă gol dacă brokerul nu are autentificare)
# USERNAME_MQTT=
# PASSWORD_MQTT=
